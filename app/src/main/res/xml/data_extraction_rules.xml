<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>

    <cloud-backup>
        <!-- Sesión cifrada: NO se respalda -->
        <exclude domain="sharedpref" path="user_prefs_secure.xml"/>

        <!-- Opcional (privacidad extra):
             <exclude domain="database" path="."/>
        -->
    </cloud-backup>

    <device-transfer>
        <!-- También excluir en transferencia entre dispositivos -->
        <exclude domain="sharedpref" path="user_prefs_secure.xml"/>
        <exclude domain="sharedpref" path="user_prefs.xml"/>

        <!-- Opcional (privacidad extra):
             <exclude domain="database" path="."/>
        -->
    </device-transfer>

</data-extraction-rules>