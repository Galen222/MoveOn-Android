<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.MoveOn" parent="Theme.Material3.Light.NoActionBar">
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <item name="android:textColorTertiary">@color/textTertiary</item>
        <!-- =========================
             BRAND / PRIMARY (Material3)
             ========================= -->
        <item name="colorPrimary">@color/greenPrimary</item>
        <item name="colorOnPrimary">@color/textOnGreen</item>
        <item name="colorPrimaryContainer">@color/greenPrimaryVariant</item>
        <item name="colorOnPrimaryContainer">@color/textOnGreen</item>

        <item name="colorSecondary">@color/greenDark</item>
        <item name="colorOnSecondary">@color/textPrimary</item>
        <item name="colorSecondaryContainer">@color/surfaceContainer</item>
        <item name="colorOnSecondaryContainer">@color/textPrimary</item>

        <!-- (opcional, pero útil en M3) -->
        <item name="colorTertiary">@color/greenPrimaryVariant</item>
        <item name="colorOnTertiary">@color/textOnGreen</item>
        <item name="colorTertiaryContainer">@color/surfaceContainerHigh</item>
        <item name="colorOnTertiaryContainer">@color/textPrimary</item>

        <!-- =========================
             SURFACES / BACKGROUND
             ========================= -->
        <item name="colorSurface">@color/darkSurface</item>
        <item name="colorOnSurface">@color/textPrimary</item>

        <item name="colorSurfaceVariant">@color/cardBackground</item>
        <item name="colorOnSurfaceVariant">@color/textSecondary</item>

        <item name="android:colorBackground">@color/darkBackground</item>
        <item name="colorOnBackground">@color/textPrimary</item>

        <!-- Surface containers -->
        <item name="colorSurfaceContainer">@color/surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/surfaceContainerHigh</item>
        <item name="colorSurfaceContainerLow">@color/surfaceContainerLow</item>
        <item name="colorSurfaceContainerLowest">@color/surfaceContainerLowest</item>
        <item name="colorSurfaceContainerHighest">@color/surfaceContainerHighest</item>

        <!-- =========================
             OUTLINE / STATES
             ========================= -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outlineVariant</item>

        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/textPrimary</item>
        <item name="colorErrorContainer">@color/error</item>
        <item name="colorOnErrorContainer">@color/textPrimary</item>

        <!-- =========================
             SYSTEM BARS
             ========================= -->
        <item name="android:statusBarColor">@color/darkBackground</item>
        <item name="android:navigationBarColor">@color/darkBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Widgets -->
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>

    </style>

    <style name="MoveOnAuthWindowAnimation">
        <item name="android:activityOpenEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@android:anim/fade_out</item>
    </style>

    <style name="Theme.MoveOn.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/darkBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.MoveOn</item>
    </style>

    <style name="Theme.MoveOn" parent="Base.Theme.MoveOn" />

    <style name="Theme.MoveOn.Auth" parent="Theme.MoveOn">
        <item name="android:windowAnimationStyle">@style/MoveOnAuthWindowAnimation</item>
    </style>

</resources>
