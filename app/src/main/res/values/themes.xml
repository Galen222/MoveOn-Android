<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.MoveOn" parent="Theme.Material3.Light.NoActionBar">
        <item name="fontFamily">@font/space_grotesk</item>
        <!-- =========================
             BRAND / PRIMARY (Material3)
             ========================= -->
        <item name="colorPrimary">@color/greenPrimary</item>
        <item name="colorOnPrimary">@color/textOnGreen</item>
        <item name="colorPrimaryContainer">@color/greenPrimaryVariant</item>
        <item name="colorOnPrimaryContainer">@color/textPrimary</item>

        <item name="colorSecondary">@color/greenDark</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">@color/surfaceContainer</item>
        <item name="colorOnSecondaryContainer">@color/textPrimary</item>

        <!-- (opcional, pero útil en M3) -->
        <item name="colorTertiary">@color/greenPrimaryVariant</item>
        <item name="colorOnTertiary">@color/textOnGreen</item>
        <item name="colorTertiaryContainer">@color/surfaceContainerHigh</item>
        <item name="colorOnTertiaryContainer">@color/textPrimary</item>

        <!-- =========================
             SURFACES / BACKGROUND
             ========================= -->
        <item name="colorSurface">@color/surfaceBackground</item>
        <item name="colorOnSurface">@color/textPrimary</item>

        <!-- Material3 usa mucho SurfaceVariant -->
        <item name="colorSurfaceVariant">@color/cardBackground</item>
        <item name="colorOnSurfaceVariant">@color/textSecondary</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/surfaceBackground</item>
        <item name="colorOnBackground">@color/textPrimary</item>

        <!-- Surface containers (Material3) -->
        <item name="colorSurfaceContainer">@color/surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/surfaceContainerHigh</item>
        <item name="colorSurfaceContainerLow">@color/surfaceContainerLow</item>
        <item name="colorSurfaceContainerLowest">@color/surfaceContainerLowest</item>
        <item name="colorSurfaceContainerHighest">@color/surfaceContainerHighest</item>

        <!-- =========================
             OUTLINE / STATES
             ========================= -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outlineVariant</item>

        <item name="colorError">@color/error</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorErrorContainer">@color/error</item>
        <item name="colorOnErrorContainer">#FFFFFF</item>

        <!-- =========================
             SYSTEM BARS
             ========================= -->
        <item name="android:statusBarColor">@color/surfaceBackground</item>
        <item name="android:navigationBarColor">@color/surfaceBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Widgets -->
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>

    </style>

    <style name="Theme.MoveOn.Starting" parent="Theme.SplashScreen">
        <!-- Fondo de splash (cambia solo con tu colors.xml / colors-night.xml) -->
        <item name="windowSplashScreenBackground">@color/surfaceBackground</item>

        <!-- Icono de splash -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>

        <!-- Tema real de la app al terminar splash -->
        <item name="postSplashScreenTheme">@style/Theme.MoveOn</item>
    </style>

    <style name="Theme.MoveOn" parent="Base.Theme.MoveOn" />

</resources>