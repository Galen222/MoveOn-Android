<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    android:paddingVertical="10dp">

    <!-- Posición -->
    <TextView
        android:id="@+id/tv_ranking_posicion"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@color/textSecondary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="1" />

    <!-- Foto de perfil -->
    <ImageView
        android:id="@+id/iv_ranking_foto"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:src="@drawable/default_profile"
        android:contentDescription="@null"
        app:layout_constraintStart_toEndOf="@id/tv_ranking_posicion"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Nombre + km (columna central) -->
    <LinearLayout
        android:id="@+id/layout_ranking_nombre_km"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@id/iv_ranking_foto"
        app:layout_constraintEnd_toStartOf="@id/tv_ranking_puntos"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tv_ranking_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/textPrimary"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="alvaro_runner" />

        <TextView
            android:id="@+id/tv_ranking_km"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="@color/textSecondary"
            tools:text="142.3 km" />

    </LinearLayout>

    <!-- Puntos -->
    <TextView
        android:id="@+id/tv_ranking_puntos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/greenPrimary"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="142 pts" />

</androidx.constraintlayout.widget.ConstraintLayout>