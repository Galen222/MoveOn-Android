<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surfaceBackground"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/auth_section_spacing"
        tools:context=".ui.auth.ForgotPasswordActivity">

        <!-- Logo -->
        <ImageView
            android:id="@+id/ivMoveOn"
            android:layout_width="@dimen/auth_logo_size_register"
            android:layout_height="@dimen/auth_logo_size_register"
            android:layout_marginTop="@dimen/auth_logo_margin_top_register"
            android:contentDescription="@string/forgot_logo_desc"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/moveon" />

        <!-- Título -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_title_margin_top"
            android:text="@string/forgot_title"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/auth_title_size"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivMoveOn" />

        <!-- Descripción dinámica (cambia entre paso 1 y paso 2) -->
        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginTop="@dimen/auth_subtitle_margin_top"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:gravity="center"
            android:text="@string/forgot_description_step1"
            android:textColor="@color/textSecondary"
            android:textSize="@dimen/auth_subtitle_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            tools:text="@string/forgot_description_step1" />

        <!-- ══════════════════════════════════════
             PASO 1: campo de email
             Visibilidad: VISIBLE en paso 1, GONE en paso 2
             ══════════════════════════════════════ -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginTop="@dimen/auth_section_spacing"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:hint="@string/forgot_hint_email"
            android:visibility="visible"
            app:boxStrokeColor="@color/greenPrimary"
            app:hintTextColor="@color/greenPrimary"
            app:startIconDrawable="@drawable/email_icon"
            app:startIconTint="@color/textSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDescripcion"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:imeOptions="actionDone"
                android:textColor="@color/textPrimary" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ══════════════════════════════════════
             PASO 2: código de verificación
             Visibilidad: GONE en paso 1, VISIBLE en paso 2
             ══════════════════════════════════════ -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCodigo"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginTop="@dimen/auth_section_spacing"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:hint="@string/forgot_hint_codigo"
            android:visibility="gone"
            app:boxStrokeColor="@color/greenPrimary"
            app:hintTextColor="@color/greenPrimary"
            app:startIconDrawable="@drawable/lock_icon"
            app:startIconTint="@color/textSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDescripcion"
            tools:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCodigo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1"
                android:imeOptions="actionNext"
                android:textColor="@color/textPrimary" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Nueva contraseña -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPasswordNueva"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginTop="@dimen/auth_field_spacing"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:hint="@string/forgot_hint_password_nueva"
            android:visibility="gone"
            app:boxStrokeColor="@color/greenPrimary"
            app:hintTextColor="@color/greenPrimary"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/textSecondary"
            app:startIconDrawable="@drawable/lock_icon"
            app:startIconTint="@color/textSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tilCodigo"
            tools:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPasswordNueva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1"
                android:imeOptions="actionNext"
                android:textColor="@color/textPrimary" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Confirmar nueva contraseña -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPasswordConfirmar"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginTop="@dimen/auth_field_spacing"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:hint="@string/forgot_hint_password_confirmar"
            android:visibility="gone"
            app:boxStrokeColor="@color/greenPrimary"
            app:hintTextColor="@color/greenPrimary"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/textSecondary"
            app:startIconDrawable="@drawable/lock_icon"
            app:startIconTint="@color/textSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tilPasswordNueva"
            tools:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPasswordConfirmar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1"
                android:imeOptions="actionDone"
                android:textColor="@color/textPrimary" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Barrera dinámica: se ancla al campo visible más bajo de cada paso.
             barrierAllowsGoneWidgets="false" → ignora las vistas GONE,
             así el botón siempre queda justo debajo del último campo visible. -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierCampos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:barrierAllowsGoneWidgets="false"
            app:constraint_referenced_ids="tilEmail,tilPasswordConfirmar" />

        <!-- Botón principal (texto cambia dinámicamente según el paso) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccion"
            android:layout_width="0dp"
            android:layout_height="@dimen/auth_button_height"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginTop="@dimen/auth_section_spacing"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:text="@string/forgot_btn_enviar_codigo"
            android:contentDescription="@string/forgot_btn_enviar_codigo"
            android:textSize="@dimen/auth_button_text_size"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="@dimen/auth_button_radius"
            app:backgroundTint="@color/greenPrimary"
            android:textColor="@color/textOnGreen"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrierCampos" />

        <!-- Volver al inicio de sesión -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverLogin"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_field_spacing"
            android:text="@string/forgot_btn_volver_login"
            android:contentDescription="@string/forgot_btn_volver_login"
            android:textColor="@color/greenPrimary"
            android:textSize="@dimen/auth_forgot_text_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnAccion" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>