<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surfaceBackground"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/auth_section_spacing"
        tools:context=".ui.auth.RegisterActivity">

        <!-- Logo -->
        <ImageView
            android:id="@+id/ivMoveOn"
            android:layout_width="@dimen/auth_logo_size_register"
            android:layout_height="@dimen/auth_logo_size_register"
            android:layout_marginTop="@dimen/auth_logo_margin_top_register"
            android:contentDescription="@string/registro_logo_desc"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/moveon" />

        <!-- Título -->
        <TextView
            android:id="@+id/tvCrearCuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_title_margin_top"
            android:fontFamily="sans-serif-medium"
            android:text="@string/registro_titulo"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/auth_title_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivMoveOn" />

        <!-- Subtítulo -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_subtitle_margin_top"
            android:text="@string/registro_subtitulo"
            android:textColor="@color/textSecondary"
            android:textSize="@dimen/auth_subtitle_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvCrearCuenta" />

        <!-- Campo Usuario -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilUsuario"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginTop="@dimen/auth_first_field_margin_top"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:hint="@string/registro_hint_usuario"
            app:boxStrokeColor="@color/greenPrimary"
            app:hintTextColor="@color/greenPrimary"
            app:startIconTint="@color/textSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvSubtitle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textNoSuggestions"
                android:textColor="@color/textPrimary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Correo -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilUsuarioCorreo"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginTop="@dimen/auth_field_spacing"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:hint="@string/registro_hint_correo"
            app:boxStrokeColor="@color/greenPrimary"
            app:hintTextColor="@color/greenPrimary"
            app:startIconTint="@color/textSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tilUsuario">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUsuarioCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:textColor="@color/textPrimary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Fecha Nacimiento -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFechaNacimiento"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginTop="@dimen/auth_field_spacing"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:hint="@string/registro_hint_fecha"
            app:boxStrokeColor="@color/greenPrimary"
            app:hintTextColor="@color/greenPrimary"
            app:startIconTint="@color/textSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tilUsuarioCorreo">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFechaNacimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:inputType="none"
                android:textColor="@color/textPrimary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Contraseña -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginTop="@dimen/auth_field_spacing"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:hint="@string/registro_hint_password"
            app:boxStrokeColor="@color/greenPrimary"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/textSecondary"
            app:hintTextColor="@color/greenPrimary"
            app:startIconTint="@color/textSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tilFechaNacimiento">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/textPrimary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Confirmar Contraseña -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilConfirmarPassword"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginTop="@dimen/auth_field_spacing"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:hint="@string/registro_hint_confirmar_password"
            app:boxStrokeColor="@color/greenPrimary"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/textSecondary"
            app:hintTextColor="@color/greenPrimary"
            app:startIconTint="@color/textSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tilPassword">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmarPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/textPrimary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Fila EULA: checkbox + texto dentro de un LinearLayout horizontal
             con los mismos márgenes que los campos del formulario para que
             quede alineado tanto en móvil como en tablet. -->
        <LinearLayout
            android:id="@+id/layout_eula_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginTop="@dimen/auth_section_spacing"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tilConfirmarPassword">

            <CheckBox
                android:id="@+id/cbEula"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/greenPrimary"
                android:contentDescription="@string/registro_eula_desc" />

            <TextView
                android:id="@+id/tvEulaText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/registro_eula_text_margin_start"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/registro_eula_text_size"
                tools:text="He leído y acepto los Términos y condiciones y la Política de privacidad" />

        </LinearLayout>

        <!-- Error EULA -->
        <TextView
            android:id="@+id/tvEulaError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginTop="@dimen/registro_eula_error_margin_top"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:text="@string/registro_error_eula_no_aceptado"
            android:textColor="@color/error"
            android:textSize="@dimen/registro_eula_error_text_size"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_eula_row" />

        <!-- Botón Crear Cuenta -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrearCuenta"
            android:layout_width="0dp"
            android:layout_height="@dimen/auth_button_height"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginTop="@dimen/auth_section_spacing"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:contentDescription="@string/registro_btn_crear_desc"
            android:fontFamily="sans-serif-medium"
            android:text="@string/registro_btn_crear"
            android:textColor="@color/textOnGreen"
            android:textSize="@dimen/auth_button_text_size"
            app:backgroundTint="@color/greenPrimary"
            app:cornerRadius="@dimen/auth_button_radius"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvEulaError" />

        <View
            android:id="@+id/dividerSocialRegisterLeft"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginEnd="@dimen/auth_divider_margin_side"
            android:background="@color/dividerColor"
            app:layout_constraintBottom_toBottomOf="@+id/tvOrSocialRegister"
            app:layout_constraintEnd_toStartOf="@+id/tvOrSocialRegister"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnCrearCuenta"
            app:layout_constraintVertical_bias="0.5" />

        <TextView
            android:id="@+id/tvOrSocialRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_section_spacing"
            android:text="@string/login_divisor"
            android:textColor="@color/textSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnCrearCuenta" />

        <View
            android:id="@+id/dividerSocialRegisterRight"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/auth_divider_margin_side"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:background="@color/dividerColor"
            app:layout_constraintBottom_toBottomOf="@+id/tvOrSocialRegister"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvOrSocialRegister"
            app:layout_constraintTop_toBottomOf="@+id/btnCrearCuenta"
            app:layout_constraintVertical_bias="0.5" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogleRegister"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/auth_button_height"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginTop="@dimen/auth_section_spacing"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:fontFamily="sans-serif-medium"
            android:text="@string/social_google_continue"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/auth_button_text_size"
            app:cornerRadius="@dimen/auth_button_radius"
            app:strokeColor="@color/dividerColor"
            app:strokeWidth="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvOrSocialRegister" />

        <!-- ¿Ya tienes cuenta? -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_field_spacing"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnGoogleRegister">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="@string/registro_ya_tienes_cuenta"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/auth_link_text_size" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIniciarSesion"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/registro_iniciar_sesion_desc"
                android:fontFamily="sans-serif-medium"
                android:text="@string/registro_iniciar_sesion"
                android:textColor="@color/greenPrimary"
                android:textSize="@dimen/auth_link_text_size" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
