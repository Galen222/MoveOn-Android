<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surfaceBackground"
    tools:ignore="TooManyViews">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:paddingTop="36dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_ranking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:rippleColor="?attr/colorControlHighlight">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_ranking_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/ranking_title"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/iv_ranking_chevron"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_ranking_chevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/textTertiary" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_recent_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/stats_section_recent"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_recent_day0_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/stats_period_today"
                            android:textColor="@color/textPrimary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_today_distance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/textPrimary"
                            android:textSize="14sp"
                            tools:text="5.20 km" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_recent_day1_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/stats_period_yesterday"
                            android:textColor="@color/textPrimary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_yesterday_distance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/textPrimary"
                            android:textSize="14sp"
                            tools:text="4.10 km" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_recent_day2_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/stats_period_two_days_ago"
                            android:textColor="@color/textPrimary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_day2_distance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/textPrimary"
                            android:textSize="14sp"
                            tools:text="3.35 km" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_today"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/stats_section_today"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:minHeight="@dimen/stats_metric_row_height"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="@string/stats_label_distance"
                                android:textAlignment="center"
                                android:textColor="@color/textTertiary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_today_dist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:maxLines="2"
                                android:textAlignment="center"
                                android:textColor="@color/textPrimary"
                                app:autoSizeMaxTextSize="20sp"
                                app:autoSizeMinTextSize="10sp"
                                app:autoSizeTextType="uniform"
                                tools:text="2.30 km" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/stats_metric_row_height"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@color/dividerColor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="@string/stats_label_time"
                                android:textAlignment="center"
                                android:textColor="@color/textTertiary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_today_time"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:maxLines="2"
                                android:textAlignment="center"
                                android:textColor="@color/textPrimary"
                                app:autoSizeMaxTextSize="20sp"
                                app:autoSizeMinTextSize="10sp"
                                app:autoSizeTextType="uniform"
                                tools:text="24 min" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/stats_metric_row_height"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@color/dividerColor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="@string/stats_label_calories"
                                android:textAlignment="center"
                                android:textColor="@color/textTertiary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_today_kcal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:maxLines="1"
                                android:textColor="@color/textPrimary"
                                app:autoSizeMaxTextSize="20sp"
                                app:autoSizeMinTextSize="10sp"
                                app:autoSizeTextType="uniform"
                                tools:text="180 kcal" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_weekly_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/stats_section_weekly"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/ll_chart_bars"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/stats_chart_height"
                        android:baselineAligned="false"
                        android:contentDescription="@string/stats_desc_chart"
                        android:gravity="bottom"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/tv_weekly_goal_header"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="@string/stats_goal_chevron_desc"
                        android:drawablePadding="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:text="@string/stats_section_goal"
                        android:textColor="@color/textPrimary"
                        android:textSize="15sp"
                        app:drawableEndCompat="@drawable/ic_chevron_right"
                        app:drawableTint="@color/textTertiary" />

                    <TextView
                        android:id="@+id/tv_weekly_goal_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:textColor="@color/textSecondary"
                        android:textSize="14sp"
                        tools:text="Te faltan 3.2 km para tu objetivo" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_weekly_goal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        app:indicatorColor="@color/greenPrimary"
                        app:trackColor="@color/dividerColor"
                        app:trackCornerRadius="6dp"
                        app:trackThickness="12dp"
                        tools:progress="78" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_weekly_progress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/textTertiary"
                            android:textSize="12sp"
                            tools:text="19.5 km" />

                        <TextView
                            android:id="@+id/tv_weekly_goal_target"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/textTertiary"
                            android:textSize="12sp"
                            tools:text="50 km" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/dividerColor" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:minHeight="@dimen/stats_comparison_row_height"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="@string/stats_period_this_week"
                                android:textColor="@color/textTertiary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_current_week_dist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:textColor="@color/textPrimary"
                                app:autoSizeMaxTextSize="20sp"
                                app:autoSizeMinTextSize="12sp"
                                app:autoSizeTextType="uniform"
                                tools:text="18.4 km" />

                            <TextView
                                android:id="@+id/tv_current_week_kcal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="1"
                                android:textColor="@color/textTertiary"
                                android:textSize="12sp"
                                tools:text="1 240 kcal" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/stats_comparison_row_height"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:background="@color/dividerColor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="@string/stats_period_prev_week"
                                android:textColor="@color/textTertiary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_previous_week_dist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:textColor="@color/textPrimary"
                                app:autoSizeMaxTextSize="20sp"
                                app:autoSizeMinTextSize="12sp"
                                app:autoSizeTextType="uniform"
                                tools:text="14.8 km" />

                            <TextView
                                android:id="@+id/tv_previous_week_kcal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="1"
                                android:textColor="@color/textTertiary"
                                android:textSize="12sp"
                                tools:text="980 kcal" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_monthly_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/stats_section_monthly"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/ll_month_chart_bars"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/stats_chart_height"
                        android:baselineAligned="false"
                        android:contentDescription="@string/stats_desc_month_chart"
                        android:gravity="bottom"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/tv_monthly_goal_header"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="@string/stats_goal_chevron_desc"
                        android:drawablePadding="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:text="@string/stats_section_monthly_goal"
                        android:textColor="@color/textPrimary"
                        android:textSize="15sp"
                        app:drawableEndCompat="@drawable/ic_chevron_right"
                        app:drawableTint="@color/textTertiary" />

                    <TextView
                        android:id="@+id/tv_monthly_goal_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:textColor="@color/textSecondary"
                        android:textSize="14sp"
                        tools:text="Te faltan 42.1 km para tu objetivo" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_monthly_goal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        app:indicatorColor="@color/greenPrimary"
                        app:trackColor="@color/dividerColor"
                        app:trackCornerRadius="6dp"
                        app:trackThickness="12dp"
                        tools:progress="45" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_monthly_progress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/textTertiary"
                            android:textSize="12sp"
                            tools:text="67.9 km" />

                        <TextView
                            android:id="@+id/tv_monthly_goal_target"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/textTertiary"
                            android:textSize="12sp"
                            tools:text="150 km" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/dividerColor" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:minHeight="@dimen/stats_comparison_row_height"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="@string/stats_period_this_month"
                                android:textColor="@color/textTertiary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_current_month_dist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:textColor="@color/textPrimary"
                                app:autoSizeMaxTextSize="20sp"
                                app:autoSizeMinTextSize="12sp"
                                app:autoSizeTextType="uniform"
                                tools:text="38.6 km" />

                            <TextView
                                android:id="@+id/tv_current_month_kcal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="1"
                                android:textColor="@color/textTertiary"
                                android:textSize="12sp"
                                tools:text="2 840 kcal" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/stats_comparison_row_height"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:background="@color/dividerColor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="@string/stats_period_prev_month"
                                android:textColor="@color/textTertiary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_previous_month_dist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:textColor="@color/textPrimary"
                                app:autoSizeMaxTextSize="20sp"
                                app:autoSizeMinTextSize="12sp"
                                app:autoSizeTextType="uniform"
                                tools:text="27.4 km" />

                            <TextView
                                android:id="@+id/tv_previous_month_kcal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="1"
                                android:textColor="@color/textTertiary"
                                android:textSize="12sp"
                                tools:text="2 100 kcal" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_totals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/stats_section_totals"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:minHeight="@dimen/stats_metric_row_height"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_label_distance"
                                android:textColor="@color/textTertiary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_total_distance"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center_horizontal"
                                android:textAlignment="center"
                                android:textColor="@color/textPrimary"
                                android:textSize="16sp"
                                tools:text="142.3 km" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/stats_metric_row_height"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@color/dividerColor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_label_time"
                                android:textColor="@color/textTertiary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_total_time"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center_horizontal"
                                android:textAlignment="center"
                                android:textColor="@color/textPrimary"
                                android:textSize="16sp"
                                tools:text="14h 22m" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/stats_metric_row_height"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@color/dividerColor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_label_calories"
                                android:textColor="@color/textTertiary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_total_kcal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center_horizontal"
                                android:textAlignment="center"
                                android:textColor="@color/textPrimary"
                                android:textSize="16sp"
                                tools:text="10 840 kcal" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/stats_metric_row_height"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@color/dividerColor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_label_streak"
                                android:textColor="@color/textTertiary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_streak"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center_horizontal"
                                android:textAlignment="center"
                                android:textColor="@color/textPrimary"
                                android:textSize="16sp"
                                tools:text="7 días" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:drawableEndCompat="@drawable/ic_chevron_right"
                    android:drawablePadding="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:text="@string/stats_section_history"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    app:drawableTint="@color/textTertiary" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        tools:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:alpha="0.3"
            android:contentDescription="@null"
            android:src="@drawable/stats_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/stats_empty_title"
            android:textColor="@color/textPrimary"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/stats_empty_subtitle"
            android:textColor="@color/textTertiary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/stats_btn_retry"
            app:backgroundTint="@color/greenPrimary" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80FFFFFF"
        android:visibility="gone"
        tools:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/greenPrimary" />
    </FrameLayout>

</FrameLayout>