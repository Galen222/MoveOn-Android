<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surfaceBackground"
    tools:ignore="TooManyViews">

    <!-- Contenido principal -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- Card 1 — Hoy -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_today"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_section_today"
                        android:textSize="16sp"
                        android:textColor="@color/textPrimary"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:minHeight="@dimen/stats_metric_row_height">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_label_distance"
                                android:textSize="12sp"
                                android:textColor="@color/textTertiary"
                                android:maxLines="1" />
                            <TextView
                                android:id="@+id/tv_today_dist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:maxLines="1"
                                android:layout_marginTop="4dp"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="10sp"
                                app:autoSizeMaxTextSize="20sp"
                                tools:text="2.3 km" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/stats_metric_row_height"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@color/dividerColor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_label_time"
                                android:textSize="12sp"
                                android:textColor="@color/textTertiary"
                                android:maxLines="1" />
                            <TextView
                                android:id="@+id/tv_today_time"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:maxLines="1"
                                android:layout_marginTop="4dp"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="10sp"
                                app:autoSizeMaxTextSize="20sp"
                                tools:text="24 min" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/stats_metric_row_height"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@color/dividerColor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_label_calories"
                                android:textSize="12sp"
                                android:textColor="@color/textTertiary"
                                android:maxLines="1" />
                            <TextView
                                android:id="@+id/tv_today_kcal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:maxLines="1"
                                android:layout_marginTop="4dp"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="10sp"
                                app:autoSizeMaxTextSize="20sp"
                                tools:text="180 kcal" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2 — Gráfico semanal -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_weekly_chart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_section_chart"
                        android:textSize="16sp"
                        android:textColor="@color/textPrimary"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:id="@+id/ll_chart_bars"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/stats_chart_height"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:gravity="bottom"
                        android:contentDescription="@string/stats_desc_chart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3 — Objetivo semanal -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_weekly_goal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_weekly_goal_header"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/stats_section_goal"
                        android:textSize="16sp"
                        android:textColor="@color/textPrimary"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:drawablePadding="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="@string/stats_goal_chevron_desc"
                        app:drawableEndCompat="@drawable/ic_chevron_right"
                        app:drawableTint="@color/textTertiary" />

                    <TextView
                        android:id="@+id/tv_weekly_goal_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/textSecondary"
                        android:layout_marginBottom="12dp"
                        tools:text="Te faltan 3.2 km para tu objetivo" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_weekly_goal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        app:indicatorColor="@color/greenPrimary"
                        app:trackColor="@color/dividerColor"
                        app:trackCornerRadius="6dp"
                        app:trackThickness="12dp"
                        tools:progress="78" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:id="@+id/tv_weekly_progress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:textColor="@color/textTertiary"
                            tools:text="19.5 km" />
                        <TextView
                            android:id="@+id/tv_weekly_goal_target"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/textTertiary"
                            tools:text="50 km" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4 — Objetivo mensual -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_monthly_goal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_monthly_goal_header"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="@string/stats_goal_chevron_desc"
                        android:drawablePadding="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:text="@string/stats_section_monthly_goal"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp"
                        app:drawableEndCompat="@drawable/ic_chevron_right"
                        app:drawableTint="@color/textTertiary" />

                    <TextView
                        android:id="@+id/tv_monthly_goal_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/textSecondary"
                        android:layout_marginBottom="12dp"
                        tools:text="Te faltan 42.1 km para tu objetivo" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_monthly_goal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        app:indicatorColor="@color/greenPrimary"
                        app:trackColor="@color/dividerColor"
                        app:trackCornerRadius="6dp"
                        app:trackThickness="12dp"
                        tools:progress="45" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:id="@+id/tv_monthly_progress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:textColor="@color/textTertiary"
                            tools:text="67.9 km" />
                        <TextView
                            android:id="@+id/tv_monthly_goal_target"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/textTertiary"
                            tools:text="150 km" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 5 — Actividad reciente -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_recent_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_section_recent"
                        android:textSize="16sp"
                        android:textColor="@color/textPrimary"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/stats_period_today"
                            android:textSize="14sp"
                            android:textColor="@color/textPrimary" />
                        <TextView
                            android:id="@+id/tv_today_distance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/greenPrimary"
                            android:fontFamily="sans-serif-medium"
                            tools:text="2.3 km" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/stats_period_yesterday"
                            android:textSize="14sp"
                            android:textColor="@color/textSecondary" />
                        <TextView
                            android:id="@+id/tv_yesterday_distance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/textSecondary"
                            android:fontFamily="sans-serif-medium"
                            tools:text="1.5 km" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/stats_period_two_days_ago"
                            android:textSize="14sp"
                            android:textColor="@color/textSecondary" />
                        <TextView
                            android:id="@+id/tv_day2_distance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/textSecondary"
                            android:fontFamily="sans-serif-medium"
                            tools:text="3.8 km" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 6 — Comparativa semana (antes Card 7) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_week_comparison"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_section_week_comparison"
                        android:textSize="16sp"
                        android:textColor="@color/textPrimary"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:minHeight="@dimen/stats_comparison_row_height">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_period_this_week"
                                android:textSize="12sp"
                                android:textColor="@color/textTertiary"
                                android:maxLines="1" />
                            <TextView
                                android:id="@+id/tv_current_week_dist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:layout_marginTop="4dp"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="12sp"
                                app:autoSizeMaxTextSize="20sp"
                                tools:text="19.5 km" />
                            <TextView
                                android:id="@+id/tv_current_week_kcal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/textTertiary"
                                android:maxLines="1"
                                android:layout_marginTop="2dp"
                                tools:text="1 420 kcal" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/stats_comparison_row_height"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:background="@color/dividerColor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_period_prev_week"
                                android:textSize="12sp"
                                android:textColor="@color/textTertiary"
                                android:maxLines="1" />
                            <TextView
                                android:id="@+id/tv_previous_week_dist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:layout_marginTop="4dp"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="12sp"
                                app:autoSizeMaxTextSize="20sp"
                                tools:text="24.1 km" />
                            <TextView
                                android:id="@+id/tv_previous_week_kcal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/textTertiary"
                                android:maxLines="1"
                                android:layout_marginTop="2dp"
                                tools:text="1 780 kcal" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 7 — Comparativa mes (antes Card 6) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_month_comparison"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_section_month_comparison"
                        android:textSize="16sp"
                        android:textColor="@color/textPrimary"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:minHeight="@dimen/stats_comparison_row_height">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_period_this_month"
                                android:textSize="12sp"
                                android:textColor="@color/textTertiary"
                                android:maxLines="1" />
                            <TextView
                                android:id="@+id/tv_current_month_dist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:layout_marginTop="4dp"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="12sp"
                                app:autoSizeMaxTextSize="20sp"
                                tools:text="38.6 km" />
                            <TextView
                                android:id="@+id/tv_current_month_kcal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/textTertiary"
                                android:maxLines="1"
                                android:layout_marginTop="2dp"
                                tools:text="2 840 kcal" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/stats_comparison_row_height"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:background="@color/dividerColor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_period_prev_month"
                                android:textSize="12sp"
                                android:textColor="@color/textTertiary"
                                android:maxLines="1" />
                            <TextView
                                android:id="@+id/tv_previous_month_dist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:layout_marginTop="4dp"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="12sp"
                                app:autoSizeMaxTextSize="20sp"
                                tools:text="32.7 km" />
                            <TextView
                                android:id="@+id/tv_previous_month_kcal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/textTertiary"
                                android:maxLines="1"
                                android:layout_marginTop="2dp"
                                tools:text="2 410 kcal" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 8 — Totales -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_totals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_section_totals"
                        android:textSize="16sp"
                        android:textColor="@color/textPrimary"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/stats_label_distance" android:textSize="11sp" android:textColor="@color/textTertiary" />
                            <TextView android:id="@+id/tv_total_distance" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="16sp"
                                android:textColor="@color/textPrimary" android:fontFamily="sans-serif-medium"
                                android:layout_marginTop="4dp" tools:text="142.3 km" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/stats_label_time" android:textSize="11sp" android:textColor="@color/textTertiary" />
                            <TextView android:id="@+id/tv_total_time" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="16sp"
                                android:textColor="@color/textPrimary" android:fontFamily="sans-serif-medium"
                                android:layout_marginTop="4dp" tools:text="14h 22m" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/stats_label_calories" android:textSize="11sp" android:textColor="@color/textTertiary" />
                            <TextView android:id="@+id/tv_total_kcal" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="16sp"
                                android:textColor="@color/textPrimary" android:fontFamily="sans-serif-medium"
                                android:layout_marginTop="4dp" tools:text="10 840 kcal" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/stats_label_streak" android:textSize="11sp" android:textColor="@color/textTertiary" />
                            <TextView android:id="@+id/tv_streak" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="16sp"
                                android:textColor="@color/textPrimary" android:fontFamily="sans-serif-medium"
                                android:layout_marginTop="4dp" tools:text="7 días" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Ranking -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_ranking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp"
                app:rippleColor="?attr/colorControlHighlight">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_ranking_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/ranking_title"
                        android:textSize="16sp"
                        android:textColor="@color/textPrimary"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/iv_ranking_chevron"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <ImageView
                        android:id="@+id/iv_ranking_chevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@null"
                        app:tint="@color/textTertiary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 9 — Historial (abre BottomSheet al pulsar) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp"
                app:rippleColor="?attr/colorControlHighlight">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_historial_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_section_calendar"
                        android:textSize="16sp"
                        android:textColor="@color/textPrimary"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/iv_historial_chevron"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <ImageView
                        android:id="@+id/iv_historial_chevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@null"
                        app:tint="@color/textTertiary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Historial de actividades -->
            <TextView
                android:id="@+id/tv_history_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats_section_history"
                android:textSize="16sp"
                android:textColor="@color/textPrimary"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                tools:listitem="@layout/item_actividad"
                tools:itemCount="4" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Estado vacío -->
    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        tools:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/stats_icon"
            android:alpha="0.3"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stats_empty_title"
            android:textSize="18sp"
            android:textColor="@color/textPrimary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stats_empty_subtitle"
            android:textSize="14sp"
            android:textColor="@color/textTertiary"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stats_btn_retry"
            android:layout_marginTop="24dp"
            app:backgroundTint="@color/greenPrimary" />

    </LinearLayout>

    <!-- Loading overlay -->
    <FrameLayout
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80FFFFFF"
        android:visibility="gone"
        tools:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/greenPrimary" />

    </FrameLayout>

</FrameLayout>