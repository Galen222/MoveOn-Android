<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="32dp">

    <!-- Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_bottomsheet_handle" />

    <!-- Icono + título -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@android:drawable/ic_dialog_alert"
            android:background="@drawable/bg_error_circle"
            app:tint="@color/error"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/delete_account_sheet_title"
            android:textSize="18sp"
            android:textColor="@color/textPrimary"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- Subtítulo -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/delete_account_sheet_subtitle"
        android:textSize="14sp"
        android:textColor="@color/textSecondary"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginBottom="12dp" />

    <!-- Lista de lo que se pierde -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_delete_info_box"
        android:padding="14dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/delete_account_item_profile"
            android:textSize="14sp"
            android:textColor="@color/textSecondary"
            android:drawableEnd="@drawable/ic_cross_small"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:paddingVertical="6dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/dividerColor" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/delete_account_item_activities"
            android:textSize="14sp"
            android:textColor="@color/textSecondary"
            android:drawableEnd="@drawable/ic_cross_small"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:paddingVertical="6dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/dividerColor" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/delete_account_item_progress"
            android:textSize="14sp"
            android:textColor="@color/textSecondary"
            android:drawableEnd="@drawable/ic_cross_small"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:paddingVertical="6dp" />

        <View
            android:id="@+id/delete_account_google_divider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:visibility="gone"
            android:background="@color/dividerColor" />

        <TextView
            android:id="@+id/tv_delete_account_google_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="@string/delete_account_item_google_link"
            android:textSize="14sp"
            android:textColor="@color/textSecondary"
            android:drawableEnd="@drawable/ic_cross_small"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:paddingVertical="6dp" />

    </LinearLayout>

    <!-- Campo de confirmación -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/delete_account_sheet_confirm_instruction"
        android:textSize="13sp"
        android:textColor="@color/textTertiary"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_confirm"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:boxStrokeColor="@color/error"
        app:hintTextColor="@color/error">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/delete_account_sheet_confirm_hint"
            android:inputType="textCapCharacters"
            android:textColor="@color/textPrimary"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Botón eliminar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirm_delete"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:enabled="false"
        android:text="@string/delete_account_sheet_btn_delete"
        android:textAllCaps="false"
        android:textSize="15sp"
        app:backgroundTint="@color/error"
        app:cornerRadius="12dp" />

    <!-- Botón cancelar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:text="@string/dialog_btn_cancel"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:textColor="@color/textSecondary"
        app:backgroundTint="@android:color/transparent"
        app:rippleColor="?attr/colorControlHighlight" />

</LinearLayout>
