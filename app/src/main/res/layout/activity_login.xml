<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surfaceBackground"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/auth_section_spacing"
        tools:context=".ui.auth.LoginActivity">

        <!-- Logo -->
        <ImageView
            android:id="@+id/ivMoveOn"
            android:layout_width="@dimen/auth_logo_size_login"
            android:layout_height="@dimen/auth_logo_size_login"
            android:layout_marginTop="@dimen/auth_logo_margin_top_register"
            android:contentDescription="@string/login_logo_desc"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/moveon" />

        <!-- Título -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_title_margin_top"
            android:text="@string/login_titulo"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/auth_title_size"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivMoveOn" />

        <!-- Subtítulo -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_subtitle_margin_top"
            android:text="@string/login_subtitulo"
            android:textColor="@color/textSecondary"
            android:textSize="@dimen/auth_subtitle_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvWelcome" />

        <!-- Campo Usuario/Correo -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilUsuario_Correo"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginTop="@dimen/auth_section_spacing"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:hint="@string/login_hint_usuario_correo"
            app:boxStrokeColor="@color/greenPrimary"
            app:hintTextColor="@color/greenPrimary"
            app:startIconDrawable="@drawable/email_icon"
            app:startIconTint="@color/textSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvSubtitle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUsuario_Correo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textNoSuggestions"
                android:textColor="@color/textPrimary"
                tools:ignore="TextContrastCheck"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Contraseña -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginTop="@dimen/auth_field_spacing"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:hint="@string/login_hint_password"
            app:boxStrokeColor="@color/greenPrimary"
            app:hintTextColor="@color/greenPrimary"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/textSecondary"
            app:startIconDrawable="@drawable/lock_icon"
            app:startIconTint="@color/textSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tilUsuario_Correo">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/textPrimary"
                tools:ignore="TextContrastCheck"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Recordar cuenta -->
        <CheckBox
            android:id="@+id/cbRecordarCuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginTop="4dp"
            android:text="@string/login_recordar_cuenta"
            android:textColor="@color/textSecondary"
            android:textSize="@dimen/auth_forgot_text_size"
            android:buttonTint="@color/greenPrimary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tilPassword" />

        <!-- ¿Olvidaste tu contraseña? -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOlvidarPassword"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:text="@string/login_olvidaste_password"
            android:contentDescription="@string/login_olvidaste_desc"
            android:textColor="@color/greenPrimary"
            android:textSize="@dimen/auth_forgot_text_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cbRecordarCuenta" />

        <!-- Botón Iniciar Sesión -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="0dp"
            android:layout_height="@dimen/auth_button_height"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginTop="@dimen/auth_section_spacing"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:text="@string/login_btn_entrar"
            android:contentDescription="@string/login_btn_entrar_desc"
            android:textSize="@dimen/auth_button_text_size"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="@dimen/auth_button_radius"
            app:backgroundTint="@color/greenPrimary"
            android:textColor="@color/textOnGreen"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnOlvidarPassword" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogleLogin"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/auth_button_height"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginTop="@dimen/auth_field_spacing"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:fontFamily="sans-serif-medium"
            android:text="@string/social_google_continue"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/auth_button_text_size"
            app:cornerRadius="@dimen/auth_button_radius"
            app:strokeColor="@color/dividerColor"
            app:strokeWidth="2dp"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnLogin" />

        <!-- Divisor con "O" -->
        <TextView
            android:id="@+id/tvOr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auth_section_spacing"
            android:text="@string/login_divisor"
            android:textColor="@color/textSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnGoogleLogin" />

        <View
            android:id="@+id/divider1"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginEnd="@dimen/auth_divider_margin_side"
            android:background="@color/dividerColor"
            app:layout_constraintBottom_toBottomOf="@+id/tvOr"
            app:layout_constraintEnd_toStartOf="@+id/tvOr"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvOr" />

        <View
            android:id="@+id/divider2"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/auth_divider_margin_side"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:background="@color/dividerColor"
            app:layout_constraintBottom_toBottomOf="@+id/tvOr"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvOr"
            app:layout_constraintTop_toTopOf="@+id/tvOr" />

        <!-- Botón Registrar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegistrar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/auth_button_height"
            android:layout_marginStart="@dimen/auth_margin_horizontal"
            android:layout_marginTop="@dimen/auth_section_spacing"
            android:layout_marginEnd="@dimen/auth_margin_horizontal"
            android:text="@string/login_btn_registrar"
            android:contentDescription="@string/login_btn_registrar_desc"
            android:textSize="@dimen/auth_button_text_size"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/greenPrimary"
            app:cornerRadius="@dimen/auth_button_radius"
            app:strokeColor="@color/greenPrimary"
            app:strokeWidth="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvOr" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/overlayGoogleLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CCFFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGoogleLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/auth_loading_overlay_margin"
            app:cardBackgroundColor="@color/surfaceBackground"
            app:cardCornerRadius="@dimen/auth_loading_card_radius"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/auth_loading_card_padding">

                <ImageView
                    android:id="@+id/ivGoogleLoadingAvatar"
                    android:layout_width="@dimen/auth_loading_avatar_size"
                    android:layout_height="@dimen/auth_loading_avatar_size"
                    android:contentDescription="@string/social_google_continue"
                    app:srcCompat="@drawable/ic_google" />

                <TextView
                    android:id="@+id/tvGoogleLoadingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/social_google_loading_title"
                    android:textColor="@color/textPrimary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvGoogleLoadingMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/social_google_loading_message_signin"
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressGoogleLoading"
                    android:layout_width="@dimen/auth_loading_indicator_size"
                    android:layout_height="@dimen/auth_loading_indicator_size"
                    android:layout_marginTop="18dp"
                    app:indicatorColor="@color/greenPrimary"
                    app:trackColor="@color/dividerColor" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</FrameLayout>



