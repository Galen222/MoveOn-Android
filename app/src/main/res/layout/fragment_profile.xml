<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surfaceBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/activity_horizontal_margin"
            android:paddingEnd="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:paddingBottom="32dp">

            <!-- ── Cabecera ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        app:cardCornerRadius="48dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="2dp"
                        app:strokeColor="@color/greenPrimary">

                        <ImageView
                            android:id="@+id/iv_profile_picture"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/default_profile"
                            android:contentDescription="@string/profile_desc_picture"
                            tools:ignore="ImageContrastCheck" />

                    </com.google.android.material.card.MaterialCardView>

                    <ImageButton
                        android:id="@+id/fab_change_photo"
                        android:layout_width="@dimen/profile_fab_touch_size"
                        android:layout_height="@dimen/profile_fab_touch_size"
                        android:layout_gravity="bottom|end"
                        android:contentDescription="@string/profile_desc_change_photo"
                        android:src="@drawable/camera_icon"
                        android:scaleType="center"
                        android:padding="@dimen/profile_fab_icon_padding"
                        android:background="@drawable/fab_change_photo_bg"
                        android:elevation="4dp"
                        android:stateListAnimator="@null"
                        tools:ignore="ImageContrastCheck,TouchTargetSizeCheck" />

                </FrameLayout>

                <TextView
                    android:id="@+id/tv_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="22sp"
                    android:textColor="@color/textPrimary"
                    android:fontFamily="sans-serif-medium"
                    tools:text="álvaro_runner" />

                <TextView
                    android:id="@+id/tv_user_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:textColor="@color/textSecondary"
                    tools:text="alvaro@email.com" />

                <TextView
                    android:id="@+id/tv_user_points"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="13sp"
                    android:textColor="@color/greenPrimary"
                    android:fontFamily="sans-serif-medium"
                    tools:text="142 puntos" />

            </LinearLayout>

            <!-- ── Tarjeta: Información personal ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/dividerColor"
                app:cardBackgroundColor="@color/cardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_section_personal"
                        android:textSize="13sp"
                        android:textColor="@color/textTertiary"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="8dp" />

                    <!-- Nombre completo -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/item_full_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/profile_item_min_height"
                        android:paddingVertical="@dimen/profile_item_padding_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:id="@+id/tv_full_name_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_label_fullname"
                            android:textSize="12sp"
                            android:textColor="@color/textTertiary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/iv_arrow_full_name"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toTopOf="@id/tv_full_name"
                            app:layout_constraintVertical_chainStyle="packed" />

                        <TextView
                            android:id="@+id/tv_full_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="15sp"
                            android:textColor="@color/textPrimary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/iv_arrow_full_name"
                            app:layout_constraintTop_toBottomOf="@id/tv_full_name_label"
                            app:layout_constraintBottom_toBottomOf="parent"
                            tools:text="Álvaro Portillo" />

                        <ImageView
                            android:id="@+id/iv_arrow_full_name"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/arrow_icon"
                            android:contentDescription="@null"
                            app:tint="@color/textTertiary"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dividerColor" />

                    <!-- Email -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/item_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/profile_item_min_height"
                        android:paddingVertical="@dimen/profile_item_padding_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:id="@+id/tv_email_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_label_email"
                            android:textSize="12sp"
                            android:textColor="@color/textTertiary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/iv_arrow_email"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toTopOf="@id/tv_email"
                            app:layout_constraintVertical_chainStyle="packed" />

                        <TextView
                            android:id="@+id/tv_email"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="15sp"
                            android:textColor="@color/textPrimary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/iv_arrow_email"
                            app:layout_constraintTop_toBottomOf="@id/tv_email_label"
                            app:layout_constraintBottom_toBottomOf="parent"
                            tools:text="alvaro@email.com" />

                        <ImageView
                            android:id="@+id/iv_arrow_email"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/arrow_icon"
                            android:contentDescription="@null"
                            app:tint="@color/textTertiary"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dividerColor" />

                    <!-- Fecha de nacimiento -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/item_birthdate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/profile_item_min_height"
                        android:paddingVertical="@dimen/profile_item_padding_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:id="@+id/tv_birthdate_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_label_birthdate"
                            android:textSize="12sp"
                            android:textColor="@color/textTertiary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/iv_arrow_birthdate"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toTopOf="@id/tv_birthdate"
                            app:layout_constraintVertical_chainStyle="packed" />

                        <TextView
                            android:id="@+id/tv_birthdate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="15sp"
                            android:textColor="@color/textPrimary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/iv_arrow_birthdate"
                            app:layout_constraintTop_toBottomOf="@id/tv_birthdate_label"
                            app:layout_constraintBottom_toBottomOf="parent"
                            tools:text="1998-05-14" />

                        <ImageView
                            android:id="@+id/iv_arrow_birthdate"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/arrow_icon"
                            android:contentDescription="@null"
                            app:tint="@color/textTertiary"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dividerColor" />

                    <!-- Provincia -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/item_provincia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/profile_item_min_height"
                        android:paddingVertical="@dimen/profile_item_padding_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:id="@+id/tv_provincia_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_label_provincia"
                            android:textSize="12sp"
                            android:textColor="@color/textTertiary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/iv_arrow_provincia"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toTopOf="@id/tv_provincia"
                            app:layout_constraintVertical_chainStyle="packed" />

                        <TextView
                            android:id="@+id/tv_provincia"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="15sp"
                            android:textColor="@color/textPrimary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/iv_arrow_provincia"
                            app:layout_constraintTop_toBottomOf="@id/tv_provincia_label"
                            app:layout_constraintBottom_toBottomOf="parent"
                            tools:text="Cádiz" />

                        <ImageView
                            android:id="@+id/iv_arrow_provincia"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/arrow_icon"
                            android:contentDescription="@null"
                            app:tint="@color/textTertiary"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dividerColor" />

                    <!-- Género -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/item_genero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/profile_item_min_height"
                        android:paddingVertical="@dimen/profile_item_padding_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:id="@+id/tv_genero_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_label_genero"
                            android:textSize="12sp"
                            android:textColor="@color/textTertiary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/iv_arrow_genero"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toTopOf="@id/tv_genero"
                            app:layout_constraintVertical_chainStyle="packed" />

                        <TextView
                            android:id="@+id/tv_genero"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="15sp"
                            android:textColor="@color/textPrimary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/iv_arrow_genero"
                            app:layout_constraintTop_toBottomOf="@id/tv_genero_label"
                            app:layout_constraintBottom_toBottomOf="parent"
                            tools:text="Hombre" />

                        <ImageView
                            android:id="@+id/iv_arrow_genero"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/arrow_icon"
                            android:contentDescription="@null"
                            app:tint="@color/textTertiary"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dividerColor" />

                    <!-- Altura y Peso: dos columnas con ConstraintLayout para evitar nested weights -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/profile_item_min_height">

                        <LinearLayout
                            android:id="@+id/item_altura"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_vertical"
                            android:paddingTop="@dimen/profile_item_padding_vertical"
                            android:paddingBottom="@dimen/profile_item_padding_vertical"
                            android:paddingStart="0dp"
                            android:paddingEnd="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/divider_altura_peso"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_label_altura"
                                android:textSize="12sp"
                                android:textColor="@color/textTertiary" />

                            <TextView
                                android:id="@+id/tv_altura"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textSize="15sp"
                                android:textColor="@color/textPrimary"
                                tools:text="175 cm" />

                        </LinearLayout>

                        <View
                            android:id="@+id/divider_altura_peso"
                            android:layout_width="1dp"
                            android:layout_height="0dp"
                            android:background="@color/dividerColor"
                            app:layout_constraintStart_toEndOf="@id/item_altura"
                            app:layout_constraintEnd_toStartOf="@id/item_peso"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <LinearLayout
                            android:id="@+id/item_peso"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_vertical"
                            android:paddingTop="@dimen/profile_item_padding_vertical"
                            android:paddingBottom="@dimen/profile_item_padding_vertical"
                            android:paddingStart="8dp"
                            android:paddingEnd="0dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            app:layout_constraintStart_toEndOf="@id/divider_altura_peso"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profile_label_peso"
                                android:textSize="12sp"
                                android:textColor="@color/textTertiary" />

                            <TextView
                                android:id="@+id/tv_peso"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textSize="15sp"
                                android:textColor="@color/textPrimary"
                                tools:text="70.0 kg" />

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Tarjeta: Comunidad ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/dividerColor"
                app:cardBackgroundColor="@color/cardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_section_community"
                        android:textSize="13sp"
                        android:textColor="@color/textTertiary"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="8dp" />

                    <!-- item_ranking: touch target garantizado con minHeight -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/item_ranking"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/profile_item_min_height"
                        android:paddingVertical="@dimen/profile_item_padding_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_item_ranking"
                            android:textSize="15sp"
                            android:textColor="@color/textPrimary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/iv_arrow_ranking"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <ImageView
                            android:id="@+id/iv_arrow_ranking"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/arrow_icon"
                            android:contentDescription="@null"
                            app:tint="@color/textTertiary"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dividerColor" />

                    <!-- item_share_routes: touch target garantizado con minHeight -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/item_share_routes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/profile_item_min_height"
                        android:paddingVertical="@dimen/profile_item_padding_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_item_share_routes"
                            android:textSize="15sp"
                            android:textColor="@color/textPrimary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/iv_arrow_share"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <ImageView
                            android:id="@+id/iv_arrow_share"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/arrow_icon"
                            android:contentDescription="@null"
                            app:tint="@color/textTertiary"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Tarjeta: Privacidad y apariencia ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/dividerColor"
                app:cardBackgroundColor="@color/cardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_section_preferences"
                        android:textSize="13sp"
                        android:textColor="@color/textTertiary"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="8dp" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/profile_item_min_height"
                        android:paddingVertical="@dimen/profile_item_padding_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_item_public_profile"
                            android:textSize="15sp"
                            android:textColor="@color/textPrimary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/switch_public_profile"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_public_profile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="@color/switch_thumb_color"
                            app:trackTint="@color/switch_track_color"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dividerColor" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/profile_item_min_height"
                        android:paddingVertical="@dimen/profile_item_padding_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_item_notifications"
                            android:textSize="15sp"
                            android:textColor="@color/textPrimary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/switch_notifications"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_notifications"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="@color/switch_thumb_color"
                            app:trackTint="@color/switch_track_color"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dividerColor" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/profile_item_padding_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_item_theme"
                            android:textSize="15sp"
                            android:textColor="@color/textPrimary" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/toggle_theme_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:singleSelection="true"
                            app:selectionRequired="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_theme_light"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/profile_theme_light"
                                android:textAllCaps="false"
                                app:backgroundTint="@color/theme_mode_button_bg"
                                android:textColor="@color/theme_mode_button_text"
                                app:strokeColor="@color/theme_mode_button_stroke"
                                app:strokeWidth="1dp"
                                tools:ignore="ButtonStyle" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_theme_dark"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/profile_theme_dark"
                                android:textAllCaps="false"
                                app:backgroundTint="@color/theme_mode_button_bg"
                                android:textColor="@color/theme_mode_button_text"
                                app:strokeColor="@color/theme_mode_button_stroke"
                                app:strokeWidth="1dp"
                                tools:ignore="ButtonStyle" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_theme_system"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/profile_theme_auto"
                                android:textAllCaps="false"
                                app:backgroundTint="@color/theme_mode_button_bg"
                                android:textColor="@color/theme_mode_button_text"
                                app:strokeColor="@color/theme_mode_button_stroke"
                                app:strokeWidth="1dp"
                                tools:ignore="ButtonStyle" />

                        </com.google.android.material.button.MaterialButtonToggleGroup>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- btn_logout: wrap_content + gravedad central para evitar "too wide" -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_logout"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:minWidth="@dimen/profile_logout_min_width"
                android:text="@string/profile_btn_logout"
                android:textAllCaps="false"
                android:textColor="@color/error"
                app:strokeColor="@color/error"
                app:strokeWidth="1dp"
                app:backgroundTint="@android:color/transparent" />

        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/greenPrimary" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>